{
	"repositories" : [{
			"type" : "package",
			"package" : {
				"name" : "boldgrid/tdcron",
				"version" : "dev-master",
				"source" : {
					"url" : "https://github.com/boldgrid/tdcron",
					"type" : "git",
					"reference" : "origin/master"
				}
			}
		}
	],
	"require" : {
		"php": ">=7.4",
		"boldgrid/library" : "^2.13.15",
		"boldgrid/tdcron" : "dev-master",
		"phpseclib/phpseclib" : "~3.0",
		"ifsnop/mysqldump-php": "^2.11"
	},
	"require-dev" : {
		"squizlabs/php_codesniffer": "^3.11",
		"wp-coding-standards/wpcs": "^3.1",
		"lox/xhprof" : "dev-master",
		"phpunit/phpunit": "^8",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config" : {
		"platform" : {
			"php" : "7.4"
		},
		"audit" : {
			"ignore" : {
				"PKSA-z3gr-8qht-p93v" : "phpunit/phpunit is require-dev only; advisory is PHPT coverage deserialization (CVE-2026-24765). No patched 7.x release exists; revisit when upgrading PHPUnit."
			}
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts" : {
		"post-autoload-dump" : "composer run-script post-autoload-dump -d ./vendor/boldgrid/library"
	}
}
